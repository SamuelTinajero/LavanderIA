# Puerto local (App Service define el suyo)
PORT=3000
# Endpoint del proyecto de Microsoft Foundry:
# https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
FOUNDRY_PROJECT_ENDPOINT=
# Nombre del agente creado con "npm run create-agent"
FOUNDRY_AGENT_NAME=lavanderia-bot
# Nombre del despliegue del modelo en Foundry (solo para create-agent)
FOUNDRY_MODEL_DEPLOYMENT=
# Si se deja vacío el endpoint, la app funciona en modo simulado (sin Azure).
# DATA_DIR=./datos
